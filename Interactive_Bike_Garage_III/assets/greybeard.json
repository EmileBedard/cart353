{
  "version": 8,
  "name": "Greybeard OpenMapTiles",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://assets/montreal.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#8a959e"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e0e0e0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d0d0d0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#8a959e"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8a959e",
        "line-width": 1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "building",
      "paint": {
        "fill-color": "#cdcdcd",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "protomaps",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          12,
          1.5,
          16,
          4
        ]
      }
    }
  ]
}